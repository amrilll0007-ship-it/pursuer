local function LoadAccessories()
    for _, AccData in pairs(Accessories) do
        local Acc = Instance.new("Accessory")
        local Handle = Instance.new("Part")
        Handle.Name = "Handle"
        Handle.Size = Vector3.new(1,1,1)
        Handle.Transparency = 1
        Handle.CanCollide = false
        Handle.Anchored = false
        Handle.Parent = Acc
        
        local Mesh = Instance.new("SpecialMesh")
        Mesh.MeshId = "rbxassetid://"..AccData.MeshId
        Mesh.TextureId = "rbxassetid://"..AccData.TextureId
        Mesh.Parent = Handle
        
        local Weld = Instance.new("WeldConstraint")
        Weld.Part0 = Handle
        Weld.Part1 = Character.RightHand
        Weld.Parent = Handle
        
        Handle.CFrame = Character.RightHand.CFrame * CFrame.new(0, -0.5, 0) * CFrame.Angles(math.rad(-90), 0, 0)
        
        Acc.Parent = Character
    end
end

